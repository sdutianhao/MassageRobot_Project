import os
import sys
import json
import argparse
import numpy as np
import torch
import trimesh
import datetime
import subprocess

from pipeline.config_pipeline import *

# Backward-compatible default (config defines MODE, not DEFAULT_MODE)
DEFAULT_MODE = MODE

sys.path.append("/home/hsmr/MassageRobot_Project/RobotBridge")


# ==========================================
# 1. 数据生成/加载 (Data Generation & Load)
# ==========================================

def _ensure_dir(path):
    os.makedirs(path, exist_ok=True)
    return path


def gen_synthetic_data(mesh_path, out_dir):
    """
    生成合成深度图数据
    """
    from pipeline.gen_synthetic_data import gen_synthetic_data_main
    _ensure_dir(out_dir)
    return gen_synthetic_data_main(mesh_path, out_dir)


def load_real_data(depth_npy, out_dir):
    """
    加载真实深度图数据（如果 out_dir 不为空，则复制保存一份）
    """
    from pipeline.load_real_data import load_real_data_main
    _ensure_dir(out_dir) if out_dir else None
    return load_real_data_main(depth_npy, out_dir)


def generate_gt_init_npz(out_dir):
    """
    生成“完美 Stage1”初始化结果（以 GT pose / cam 为准）
    """
    from pipeline.force_gt_init import force_gt_init_main
    _ensure_dir(out_dir)
    return force_gt_init_main(out_dir)


# ==========================================
# 2. Stage1 / Stage2 / Stage3 调用封装
# ==========================================

def run_stage1(data_ctx, mesh_obj, out_dir):
    """
    调用 stage1.run_stage1
    """
    print(f"[*] Running Stage 1 -> {out_dir}")
    _ensure_dir(out_dir)
    cmd = [
        sys.executable, "-m", "stage1.run_stage1",
        "--mesh_obj", mesh_obj,
        "--data_json", json.dumps(data_ctx),
        "--out_dir", out_dir
    ]
    subprocess.check_call(cmd)
    return os.path.join(out_dir, "stage1_result.npz")


def run_stage2(mesh_obj, stage1_npz, depth_obs_npy, out_dir, init_noise_std=0.0):
    """
    调用 stage2.run_stage2
    """
    print(f"[*] Running Stage 2 -> {out_dir} [Noise={init_noise_std}]")
    _ensure_dir(out_dir)
    cmd = [
        sys.executable, "-m", "stage2.run_stage2",
        "--mesh_obj", mesh_obj,
        "--stage1_npz", stage1_npz,
        "--depth_obs_npy", depth_obs_npy,
        "--out_dir", out_dir,
        "--init_noise_std", str(init_noise_std)
    ]


    subprocess.check_call(cmd)
    return os.path.join(out_dir, "theta_opt.npy")


def run_stage3(mesh_obj, stage1_npz, depth_obs_npy, out_dir, init_noise_std=0.0,
               stage3_data_term="ray", stage3_gmm_sigma_start=0.05, stage3_gmm_sigma_end=0.005,
               stage3_gmm_center_mode="faces",
               stage3_vis_depth_gate=-1.0, stage3_debug=False, stage3_debug_every=25, stage3_debug_dump=False, stage3_update_rot=False,
               stage3_lambda_tan=0.0, stage3_lambda_tan_anchor=0.0):
    """
    调用 stage3.run_stage3_pipeline
    """
    print(f"[*] Running Stage 3 (Micro-Skin) -> {out_dir} [Noise={init_noise_std} Term={stage3_data_term}]")
    _ensure_dir(out_dir)
    cmd = [
        sys.executable, "-m", "stage3.run_stage3_pipeline",
        "--mesh_obj", mesh_obj, 
        "--stage1_npz", stage1_npz,
        "--depth_obs_npy", depth_obs_npy,
        "--out_dir", out_dir,
        "--init_noise_std", str(init_noise_std),
        "--lr", "0.005",
        "--epochs", "200",
        "--data_term", str(stage3_data_term),
        "--gmm_sigma_start", str(stage3_gmm_sigma_start),
        "--gmm_sigma_end", str(stage3_gmm_sigma_end),
        "--vis_depth_gate", str(stage3_vis_depth_gate),
        "--lambda_tan", str(stage3_lambda_tan),
        "--lambda_tan_anchor", str(stage3_lambda_tan_anchor)
    ]
    if str(stage3_data_term) == "gmm" and str(stage3_gmm_center_mode) != "faces":
        cmd += ["--gmm_center_mode", str(stage3_gmm_center_mode)]
    if bool(stage3_update_rot):
        cmd += ["--update_rot"]
    if bool(stage3_debug):
        cmd += ["--debug", "--debug_every", str(int(stage3_debug_every))]
        if bool(stage3_debug_dump):
            cmd += ["--debug_dump"]
        print("[Stage3][DBG] enabled:", " ".join(cmd))
    subprocess.check_call(cmd)
    return os.path.join(out_dir, "displacement_opt.npy")


def run_stage3v2(mesh_obj, stage1_npz, depth_obs_npy, out_dir, init_noise_std=0.0,
                 stage3v2_data_term="gmm",
                 stage3v2_gmm_sigma_start=0.05, stage3v2_gmm_sigma_end=0.005,
                 stage3v2_gmm_center_mode="verts",
                 stage3v2_vis_depth_gate=0.06,
                 stage3v2_update_rot=False,
                 stage3v2_debug=False, stage3v2_debug_every=40, stage3v2_debug_dump=False,
                 stage3v2_lambda_inext=0.0, stage3v2_inext_eps_abs=0.002,
                 stage3v2_lambda_order=0.0, stage3v2_order_margin=0.0,
                 stage3v2_lambda_anchor=0.0, stage3v2_anchor_k=12, stage3v2_anchor_win=5, stage3v2_anchor_warmup=50,
                 stage3v2_grad_diff_alpha=0.0, stage3v2_grad_diff_every=1):
    """
    新增 Stage3V2：在不影响旧 Stage3 的前提下，引入结构正则/锚点/顺序/梯度扩散等增强项。
    调用 stage3.run_stage3_pipeline_v2
    """
    print(f"[*] Running Stage 3V2 (Micro-Skin+) -> {out_dir} [Noise={init_noise_std} Term={stage3v2_data_term}]")
    _ensure_dir(out_dir)
    cmd = [
        sys.executable, "-m", "stage3.run_stage3_pipeline_v2",
        "--mesh_obj", mesh_obj,
        "--stage1_npz", stage1_npz,
        "--depth_obs_npy", depth_obs_npy,
        "--out_dir", out_dir,
        "--init_noise_std", str(init_noise_std),
        "--lr", "0.005",
        "--epochs", "200",
        "--data_term", str(stage3v2_data_term),
        "--gmm_sigma_start", str(stage3v2_gmm_sigma_start),
        "--gmm_sigma_end", str(stage3v2_gmm_sigma_end),
        "--vis_depth_gate", str(stage3v2_vis_depth_gate),
        "--lambda_inext", str(stage3v2_lambda_inext),
        "--inext_eps_abs", str(stage3v2_inext_eps_abs),
        "--lambda_order", str(stage3v2_lambda_order),
        "--order_margin", str(stage3v2_order_margin),
        "--lambda_anchor", str(stage3v2_lambda_anchor),
        "--anchor_k", str(int(stage3v2_anchor_k)),
        "--anchor_win", str(int(stage3v2_anchor_win)),
        "--anchor_warmup", str(int(stage3v2_anchor_warmup)),
        "--grad_diff_alpha", str(stage3v2_grad_diff_alpha),
        "--grad_diff_every", str(int(stage3v2_grad_diff_every)),
    ]
    if str(stage3v2_data_term) == "gmm" and str(stage3v2_gmm_center_mode) != "faces":
        cmd += ["--gmm_center_mode", str(stage3v2_gmm_center_mode)]
    if bool(stage3v2_update_rot):
        cmd += ["--update_rot"]
    if bool(stage3v2_debug):
        cmd += ["--debug", "--debug_every", str(int(stage3v2_debug_every))]
        if bool(stage3v2_debug_dump):
            cmd += ["--debug_dump"]
        print("[Stage3V2][DBG] enabled:", " ".join(cmd))
    subprocess.check_call(cmd)
    return os.path.join(out_dir, "displacement_opt.npy")


# ==========================================
# 3. 主控流程 (Main Pipeline)
# ==========================================

def main():
    parser = argparse.ArgumentParser(description="RobotBridge Pipeline")
    parser.add_argument('--mode', type=int, default=DEFAULT_MODE)
    parser.add_argument('--steps', nargs='+',
                        default=['data', 'stage1', 'stage2', 'stage3'],
                        choices=['data', 'stage1', 'stage2', 'stage3', 'stage3v2'])
    parser.add_argument('--use_fixed_data', action='store_true', help="复用之前生成的深度图")
    parser.add_argument('--force_gt_init', action='store_true', help="跳过Stage1优化，使用GT位姿")
    
    # 噪声控制
    parser.add_argument('--perturb_theta', action='store_true', help="[Stage 2] 对初始骨架参数加噪")
    parser.add_argument('--perturb_vertices', action='store_true', help="[Stage 3] 对初始顶点加噪")

    # Stage3 GMM 控制参数
    parser.add_argument('--stage3_data_term', type=str, default='ray', choices=['ray', 'gmm'])
    parser.add_argument('--stage3_gmm_sigma_start', type=float, default=0.05)
    parser.add_argument('--stage3_gmm_sigma_end', type=float, default=0.005)
    parser.add_argument('--stage3_gmm_center_mode', type=str, default='faces', choices=['faces', 'verts'])
    parser.add_argument('--stage3_vis_depth_gate', type=float, default=-1.0)
    parser.add_argument('--stage3_debug', action='store_true')
    parser.add_argument('--stage3_debug_every', type=int, default=25)
    parser.add_argument('--stage3_debug_dump', action='store_true')
    parser.add_argument('--stage3_update_rot', action='store_true')
    parser.add_argument('--stage3_lambda_tan', type=float, default=0.0)
    parser.add_argument('--stage3_lambda_tan_anchor', type=float, default=0.0)

    # Stage3V2 (新增，不影响旧 Stage3)
    parser.add_argument('--stage3v2_data_term', type=str, default='gmm', choices=['ray', 'gmm'])
    parser.add_argument('--stage3v2_gmm_sigma_start', type=float, default=0.05)
    parser.add_argument('--stage3v2_gmm_sigma_end', type=float, default=0.005)
    parser.add_argument('--stage3v2_gmm_center_mode', type=str, default='verts', choices=['faces', 'verts'])
    parser.add_argument('--stage3v2_vis_depth_gate', type=float, default=0.06)
    parser.add_argument('--stage3v2_update_rot', action='store_true')
    parser.add_argument('--stage3v2_debug', action='store_true')
    parser.add_argument('--stage3v2_debug_every', type=int, default=40)
    parser.add_argument('--stage3v2_debug_dump', action='store_true')

    # Stage3V2 结构/锚点/顺序/扩散（全部为新增开关）
    parser.add_argument('--stage3v2_lambda_inext', type=float, default=0.0)
    parser.add_argument('--stage3v2_inext_eps_abs', type=float, default=0.002)
    parser.add_argument('--stage3v2_lambda_order', type=float, default=0.0)
    parser.add_argument('--stage3v2_order_margin', type=float, default=0.0)

    parser.add_argument('--stage3v2_lambda_anchor', type=float, default=0.0)
    parser.add_argument('--stage3v2_anchor_k', type=int, default=12)
    parser.add_argument('--stage3v2_anchor_win', type=int, default=5)
    parser.add_argument('--stage3v2_anchor_warmup', type=int, default=50)

    parser.add_argument('--stage3v2_grad_diff_alpha', type=float, default=0.0)
    parser.add_argument('--stage3v2_grad_diff_every', type=int, default=1)

    args = parser.parse_args()

    # [Hardcode] 固定数据源 (Mode 1 历史数据)
    FIXED_DIR = "/home/hsmr/MassageRobot_Project/RobotBridge/output/data_20260104_032505"
    # FIXED_DIR = "/home/hsmr/MassageRobot_Project/RobotBridge/output/20251218_201849_mode1"
    FIXED_DEPTH_NPY = os.path.join(FIXED_DIR, "source_data", "depth_obs.npy")
    FIXED_S1_NPZ = os.path.join(FIXED_DIR, "stage1", "stage1_result.npz")

    # [命名规则修正] 格式: {task}_{timestamp}
    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    
    if len(args.steps) == 1:
        # 单步骤运行，直接用步骤名作为前缀
        prefix = args.steps[0] 
    elif args.steps == ['data', 'stage1', 'stage2', 'stage3']:
        # 全流程
        prefix = "pipeline"
    elif args.steps == ['data', 'stage1', 'stage2', 'stage3v2']:
        # 全流程 (V2)
        prefix = "pipeline_v2"
    else:
        # 混合步骤
        prefix = "_".join(args.steps)
        
    dir_name = f"{prefix}_{timestamp}"
    
    run_dir = _ensure_dir(os.path.join(OUT_ROOT, dir_name))
    print(f"=== Pipeline Start | ID: {dir_name} ===")
    
    # --- [Step 1] Data ---
    data_ctx = None
    depth_obs_path = None

    if args.use_fixed_data:
        print(f"[*] Using FIXED data source: {FIXED_DEPTH_NPY}")
        if not os.path.exists(FIXED_DEPTH_NPY):
            raise FileNotFoundError(f"Fixed data missing at {FIXED_DEPTH_NPY}")
        depth_obs_path = FIXED_DEPTH_NPY
        if 'stage1' in args.steps:
            data_ctx = load_real_data(depth_obs_path, None)
    
    elif 'data' in args.steps:
        # 使用 SkelAdapter 生成
        if args.mode in (1, 2):
            data_ctx = gen_synthetic_data(MESH_OBJ, os.path.join(run_dir, "source_data"))
            depth_obs_path = os.path.join(run_dir, "source_data", "depth_obs.npy")
        elif args.mode == 3:
            data_ctx = load_real_data(REAL_DEPTH_OBS_NPY, os.path.join(run_dir, "source_data"))
            depth_obs_path = REAL_DEPTH_OBS_NPY
    else:
        # Fallback
        if args.mode == 3: depth_obs_path = REAL_DEPTH_OBS_NPY
        else: print("[Warn] No Data step. Assuming source_data exists.")

    # --- [Step 2] Stage 1 ---
    stage1_npz = None

    if args.force_gt_init:
        print("[*] Force GT Init enabled (Generating perfect Stage 1 result)...")
        stage1_npz = generate_gt_init_npz(os.path.join(run_dir, "init_gt"))

    elif 'stage1' in args.steps:
        if data_ctx:
            stage1_npz = run_stage1(data_ctx, MESH_OBJ, os.path.join(run_dir, "stage1"))
        elif args.use_fixed_data:
            print("[!] Skipping Stage 1 compute (Fixed Data mode).")
        else:
            raise RuntimeError("Cannot run Stage 1: Missing Data Context")
    else:
        # 复用
        if args.use_fixed_data and os.path.exists(FIXED_S1_NPZ):
            stage1_npz = FIXED_S1_NPZ
        else:
            stage1_npz = REAL_STAGE1_NPZ

    # --- [Step 3] Stage 2 ---
    if 'stage2' in args.steps:
        if not stage1_npz: raise ValueError("Stage 1 result missing")
        if not depth_obs_path: raise ValueError("Depth obs missing")
        
        noise_theta = 0.02 if args.perturb_theta else 0.0
        run_stage2(MESH_OBJ, stage1_npz, depth_obs_path, os.path.join(run_dir, "stage2"), noise_theta)

    # --- [Step 4] Stage 3 ---
    if 'stage3' in args.steps:
        if not stage1_npz: raise ValueError("Stage 1 result missing")
        if not depth_obs_path: raise ValueError("Depth obs missing")

        noise_vert = 0.04 if args.perturb_vertices else 0.0
        run_stage3(
            MESH_OBJ, stage1_npz, depth_obs_path, os.path.join(run_dir, "stage3"), noise_vert,
            stage3_data_term=args.stage3_data_term,
            stage3_gmm_sigma_start=args.stage3_gmm_sigma_start,
            stage3_gmm_sigma_end=args.stage3_gmm_sigma_end,
            stage3_gmm_center_mode=args.stage3_gmm_center_mode,
            stage3_vis_depth_gate=args.stage3_vis_depth_gate,
            stage3_debug=args.stage3_debug,
            stage3_debug_every=args.stage3_debug_every,
            stage3_debug_dump=args.stage3_debug_dump,
            stage3_update_rot=args.stage3_update_rot,
            stage3_lambda_tan=args.stage3_lambda_tan,
            stage3_lambda_tan_anchor=args.stage3_lambda_tan_anchor
        )

    # --- [Step 4.5] Stage 3V2 ---
    if 'stage3v2' in args.steps:
        if not stage1_npz: raise ValueError("Stage 1 result missing")
        if not depth_obs_path: raise ValueError("Depth obs missing")

        noise_vert = 0.04 if args.perturb_vertices else 0.0
        run_stage3v2(
            MESH_OBJ, stage1_npz, depth_obs_path, os.path.join(run_dir, "stage3v2"), noise_vert,
            stage3v2_data_term=args.stage3v2_data_term,
            stage3v2_gmm_sigma_start=args.stage3v2_gmm_sigma_start,
            stage3v2_gmm_sigma_end=args.stage3v2_gmm_sigma_end,
            stage3v2_gmm_center_mode=args.stage3v2_gmm_center_mode,
            stage3v2_vis_depth_gate=args.stage3v2_vis_depth_gate,
            stage3v2_debug=args.stage3v2_debug,
            stage3v2_debug_every=args.stage3v2_debug_every,
            stage3v2_debug_dump=args.stage3v2_debug_dump,
            stage3v2_update_rot=args.stage3v2_update_rot,
            stage3v2_lambda_inext=args.stage3v2_lambda_inext,
            stage3v2_inext_eps_abs=args.stage3v2_inext_eps_abs,
            stage3v2_lambda_order=args.stage3v2_lambda_order,
            stage3v2_order_margin=args.stage3v2_order_margin,
            stage3v2_lambda_anchor=args.stage3v2_lambda_anchor,
            stage3v2_anchor_k=args.stage3v2_anchor_k,
            stage3v2_anchor_win=args.stage3v2_anchor_win,
            stage3v2_anchor_warmup=args.stage3v2_anchor_warmup,
            stage3v2_grad_diff_alpha=args.stage3v2_grad_diff_alpha,
            stage3v2_grad_diff_every=args.stage3v2_grad_diff_every,
        )


    print(f"=== Pipeline Finished | Results: {run_dir} ===")

if __name__ == "__main__":
    main()
